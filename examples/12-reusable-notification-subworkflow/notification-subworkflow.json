{
  "name": "12a · Send Notification (Sub-workflow)",
  "nodes": [
    {
      "parameters": {
        "content": "## 12a · Send Notification (sub-workflow)\nA small **reusable** workflow. Other workflows call it with the *Execute Workflow* node and pass 4 inputs:\n\n`level` (info / warning / error) · `title` · `message` · `link`\n\nIt formats one consistent message and delivers it. Change the delivery channel **here once**, and every workflow that uses it is updated.\n\nTo actually send, paste a Slack/Discord webhook URL into **Deliver** and enable it.",
        "height": 340,
        "width": 480
      },
      "id": "12a00000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -360]
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "level" },
            { "name": "title" },
            { "name": "message" },
            { "name": "link" }
          ]
        }
      },
      "id": "12a00000-0000-4000-8000-000000000002",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "12a00000-0000-4000-8000-000000000101",
              "name": "text",
              "value": "={{ { info: 'ℹ️', warning: '⚠️', error: '🚨' }[$json.level] ?? '📣' }} *{{ $json.title }}*\n{{ $json.message }}{{ $json.link ? '\\n👉 ' + $json.link : '' }}",
              "type": "string"
            },
            {
              "id": "12a00000-0000-4000-8000-000000000102",
              "name": "level",
              "value": "={{ $json.level || 'info' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "12a00000-0000-4000-8000-000000000003",
      "name": "Format Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR-WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.text }) }}",
        "options": {}
      },
      "id": "12a00000-0000-4000-8000-000000000004",
      "name": "Deliver",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 100],
      "disabled": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "12a00000-0000-4000-8000-000000000103", "name": "delivered", "value": true, "type": "boolean" },
            { "id": "12a00000-0000-4000-8000-000000000104", "name": "text", "value": "={{ $('Format Message').item.json.text }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "12a00000-0000-4000-8000-000000000005",
      "name": "Return Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 100]
    }
  ],
  "connections": {
    "When Called by Another Workflow": {
      "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]]
    },
    "Format Message": {
      "main": [[{ "node": "Deliver", "type": "main", "index": 0 }]]
    },
    "Deliver": {
      "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}

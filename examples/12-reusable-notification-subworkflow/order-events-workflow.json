{
  "name": "12b · Order Events (Uses Sub-workflow)",
  "nodes": [
    {
      "parameters": {
        "content": "## 12b · Order Events\nA \"main\" workflow that needs to send notifications. Instead of building message formatting and delivery again, it **calls 12a** once per event.\n\n**After importing:** open **Notify via Sub-workflow** and pick *12a · Send Notification (Sub-workflow)* in the **Workflow** dropdown. The fields below it are filled from each event.",
        "height": 300,
        "width": 480
      },
      "id": "12b00000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -320]
    },
    {
      "parameters": {},
      "id": "12b00000-0000-4000-8000-000000000002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100]
    },
    {
      "parameters": {
        "jsCode": "// Pretend these came from your shop system.\nreturn [\n  { type: 'new_order',      orderId: 'A-1001', customer: 'Ada',   total: 129.90 },\n  { type: 'low_stock',      sku: 'MUG-BLUE',   remaining: 3 },\n  { type: 'payment_failed', orderId: 'A-1002', customer: 'Grace', total: 54.00 },\n].map(e => ({ json: e }));"
      },
      "id": "12b00000-0000-4000-8000-000000000003",
      "name": "Sample Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "12b00000-0000-4000-8000-000000000101",
              "name": "level",
              "value": "={{ { new_order: 'info', low_stock: 'warning', payment_failed: 'error' }[$json.type] }}",
              "type": "string"
            },
            {
              "id": "12b00000-0000-4000-8000-000000000102",
              "name": "title",
              "value": "={{ { new_order: 'New order ' + $json.orderId, low_stock: 'Low stock: ' + $json.sku, payment_failed: 'Payment failed for ' + $json.orderId }[$json.type] }}",
              "type": "string"
            },
            {
              "id": "12b00000-0000-4000-8000-000000000103",
              "name": "message",
              "value": "={{ $json.type === 'low_stock' ? `Only ${$json.remaining} left in stock.` : `${$json.customer} · $${$json.total.toFixed(2)}` }}",
              "type": "string"
            },
            {
              "id": "12b00000-0000-4000-8000-000000000104",
              "name": "link",
              "value": "={{ $json.orderId ? 'https://shop.example.com/admin/orders/' + $json.orderId : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "12b00000-0000-4000-8000-000000000004",
      "name": "Describe Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 100]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "level": "={{ $json.level }}",
            "title": "={{ $json.title }}",
            "message": "={{ $json.message }}",
            "link": "={{ $json.link }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "level", "displayName": "level", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "title", "displayName": "title", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "message", "displayName": "message", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "link", "displayName": "link", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {}
      },
      "id": "12b00000-0000-4000-8000-000000000005",
      "name": "Notify via Sub-workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [660, 100]
    }
  ],
  "connections": {

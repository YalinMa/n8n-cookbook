{
  "name": "06 · Website Uptime Monitor",
  "nodes": [
    {
      "parameters": {
        "content": "## 06 · Website Uptime Monitor\nEvery 5 minutes, check a list of URLs. If any site is down (HTTP status ≥ 400, timeout or DNS error) build **one** alert that lists all failing sites.\n\n- Edit the list in **Sites to Check**\n- Two demo URLs are broken on purpose so you can see an alert\n- To receive alerts, paste a Slack/Discord webhook URL into **Send Alert** and enable it\n\nNote **Check URL** → *Settings* → *On Error: Continue* — without it one dead site would stop the whole run.",
        "height": 360,
        "width": 480
      },
      "id": "06000000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -340]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "06000000-0000-4000-8000-000000000002",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 60]
    },
    {
      "parameters": {},
      "id": "06000000-0000-4000-8000-000000000003",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 240]
    },
    {
      "parameters": {
        "jsCode": "// One item per site. Add or remove lines to change what gets monitored.\nreturn [\n  { name: 'n8n.io',            url: 'https://n8n.io' },\n  { name: 'GitHub',            url: 'https://github.com' },\n  { name: 'Demo: server error', url: 'https://httpbin.org/status/503' },\n  { name: 'Demo: bad domain',  url: 'https://this-site-does-not-exist.invalid' },\n].map(site => ({ json: site }));"
      },
      "id": "06000000-0000-4000-8000-000000000004",
      "name": "Sites to Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 150]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 10000
        }
      },
      "id": "06000000-0000-4000-8000-000000000005",
      "name": "Check URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 150],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "06000000-0000-4000-8000-000000000101",
              "name": "name",
              "value": "={{ $('Sites to Check').item.json.name }}",
              "type": "string"
            },
            {
              "id": "06000000-0000-4000-8000-000000000102",
              "name": "url",
              "value": "={{ $('Sites to Check').item.json.url }}",
              "type": "string"
            },
            {
              "id": "06000000-0000-4000-8000-000000000103",
              "name": "statusCode",
              "value": "={{ $json.statusCode ?? 0 }}",
              "type": "number"
            },
            {
              "id": "06000000-0000-4000-8000-000000000104",
              "name": "isUp",
              "value": "={{ ($json.statusCode ?? 0) >= 200 && ($json.statusCode ?? 0) < 400 }}",
              "type": "boolean"
            },
            {
              "id": "06000000-0000-4000-8000-000000000105",
              "name": "problem",
              "value": "={{ $json.error ? ($json.error.message || 'request failed') : 'HTTP ' + $json.statusCode }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "06000000-0000-4000-8000-000000000006",
      "name": "Summarize Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 150]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "06000000-0000-4000-8000-000000000106",
              "leftValue": "={{ $json.isUp }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "06000000-0000-4000-8000-000000000007",
      "name": "Is Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [900, 150]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "downSites",
        "options": {}
      },
      "id": "06000000-0000-4000-8000-000000000008",
      "name": "Collect Down Sites",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1120, 60]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "06000000-0000-4000-8000-000000000107",
              "name": "text",
              "value": "=🚨 {{ $json.downSites.length }} site(s) down at {{ $now.toFormat('HH:mm') }}:\n{{ $json.downSites.map(s => `• ${s.name} (${s.url}) – ${s.problem}`).join('\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "06000000-0000-4000-8000-000000000009",
      "name": "Build Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1340, 60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR-WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.text }) }}",
        "options": {}
      },
      "id": "06000000-0000-4000-8000-000000000010",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 60],
      "disabled": true
    },
    {
      "parameters": {},
      "id": "06000000-0000-4000-8000-000000000011",
      "name": "All Good",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 260]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Sites to Check", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Sites to Check", "type": "main", "index": 0 }]]
    },
    "Sites to Check": {
      "main": [[{ "node": "Check URL", "type": "main", "index": 0 }]]
    },
    "Check URL": {
      "main": [[{ "node": "Summarize Result", "type": "main", "index": 0 }]]
    },
    "Summarize Result": {
      "main": [[{ "node": "Is Down?", "type": "main", "index": 0 }]]
    },
    "Is Down?": {
      "main": [
        [{ "node": "Collect Down Sites", "type": "main", "index": 0 }],
        [{ "node": "All Good", "type": "main", "index": 0 }]
      ]
    },
    "Collect Down Sites": {
      "main": [[{ "node": "Build Alert", "type": "main", "index": 0 }]]
    },
    "Build Alert": {
      "main": [[{ "node": "Send Alert", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}

{
  "name": "11 · Batch Geocoding with Rate Limits",
  "nodes": [
    {
      "parameters": {
        "content": "## 11 · Batch Geocoding with Rate Limits\nLook up coordinates, country and population for a list of cities. The calls are made **3 at a time, with a 1-second pause** between batches, so we never hammer the API.\n\n- **Loop Over Items** hands out batches of 3 on its *loop* output\n- After the last batch, everything comes out of its *done* output\n- `Atlantis` is in the list on purpose: it shows how to handle \"not found\"\n\nAPI: Open-Meteo Geocoding (free, no key).",
        "height": 340,
        "width": 500
      },
      "id": "11000000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -380]
    },
    {
      "parameters": {},
      "id": "11000000-0000-4000-8000-000000000002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100]
    },
    {
      "parameters": {
        "jsCode": "// Replace this list with your own (or read it from Google Sheets, a CSV, a database…)\nconst cities = [\n  'Tokyo', 'Berlin', 'São Paulo', 'Nairobi', 'Toronto', 'Sydney',\n  'Mumbai', 'Reykjavik', 'Mexico City', 'Seoul', 'Cairo', 'Atlantis',\n];\n\nreturn cities.map(city => ({ json: { city } }));"
      },
      "id": "11000000-0000-4000-8000-000000000003",
      "name": "City List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100]
    },
    {
      "parameters": {
        "batchSize": 3,
        "options": {}
      },
      "id": "11000000-0000-4000-8000-000000000004",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 100]
    },
    {
      "parameters": {
        "url": "https://geocoding-api.open-meteo.com/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "name", "value": "={{ $json.city }}" },
            { "name": "count", "value": "1" },
            { "name": "language", "value": "en" }
          ]
        },
        "options": {}
      },
      "id": "11000000-0000-4000-8000-000000000005",
      "name": "Geocode City",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "11000000-0000-4000-8000-000000000101", "name": "city", "value": "={{ $('Loop Over Items').item.json.city }}", "type": "string" },
            { "id": "11000000-0000-4000-8000-000000000102", "name": "found", "value": "={{ ($json.results ?? []).length > 0 }}", "type": "boolean" },
            { "id": "11000000-0000-4000-8000-000000000103", "name": "country", "value": "={{ $json.results?.[0]?.country ?? '' }}", "type": "string" },
            { "id": "11000000-0000-4000-8000-000000000104", "name": "latitude", "value": "={{ $json.results?.[0]?.latitude ?? null }}", "type": "number" },
            { "id": "11000000-0000-4000-8000-000000000105", "name": "longitude", "value": "={{ $json.results?.[0]?.longitude ?? null }}", "type": "number" },
            { "id": "11000000-0000-4000-8000-000000000106", "name": "population", "value": "={{ $json.results?.[0]?.population ?? 0 }}", "type": "number" },
            { "id": "11000000-0000-4000-8000-000000000107", "name": "timezone", "value": "={{ $json.results?.[0]?.timezone ?? '' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "11000000-0000-4000-8000-000000000006",
      "name": "Keep Useful Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 200]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "id": "11000000-0000-4000-8000-000000000007",
      "name": "Pause 1 Second",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 200],
      "webhookId": "11000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            { "fieldName": "population", "order": "descending" }
          ]
        },
        "options": {}
      },
      "id": "11000000-0000-4000-8000-000000000008",
      "name": "Sort by Population",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [680, -40]
    },
    {
      "parameters": {
        "options": {
          "fileName": "geocoded-cities.csv"
        }
      },
      "id": "11000000-0000-4000-8000-000000000009",
      "name": "Convert to CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [900, -40]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "City List", "type": "main", "index": 0 }]]
    },
    "City List": {
      "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]]
    },
    "Loop Over Items": {
      "main": [
        [{ "node": "Sort by Population", "type": "main", "index": 0 }],
        [{ "node": "Geocode City", "type": "main", "index": 0 }]
      ]
    },
    "Geocode City": {
      "main": [[{ "node": "Keep Useful Fields", "type": "main", "index": 0 }]]
    },
    "Keep Useful Fields": {
      "main": [[{ "node": "Pause 1 Second", "type": "main", "index": 0 }]]
    },
    "Pause 1 Second": {
      "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]]
    },
    "Sort by Population": {
      "main": [[{ "node": "Convert to CSV", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}

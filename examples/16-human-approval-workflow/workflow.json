        "responseBody": "=<!doctype html><meta charset=\"utf-8\"><title>Expense approved</title><body style=\"font-family:system-ui;padding:40px;text-align:center\"><h1>✅ Expense approved</h1><p>{{ $json.employee }} · {{ $json.amount.toFixed(2) }} €</p><p style=\"color:#888\">You can close this tab.</p></body>",
        "options": {

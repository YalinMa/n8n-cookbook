      "name": "Mark Rejected",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1800,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "16000000-0000-4000-8000-000000000117",
              "name": "status",
              "value": "auto_approved",

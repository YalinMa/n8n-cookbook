          "assignments": [
            {
              "id": "16000000-0000-4000-8000-000000000113",
              "name": "status",
              "value": "rejected",
              "type": "string"
            },
            {
              "id": "16000000-0000-4000-8000-000000000114",
              "name": "employee",
              "value": "={{ $('Read Request').item.json.employee }}",
              "type": "string"
            },
            {
              "id": "16000000-0000-4000-8000-000000000115",
              "name": "amount",
              "value": "={{ $('Read Request').item.json.amount }}",
              "type": "number"
            },
            {
              "id": "16000000-0000-4000-8000-000000000116",

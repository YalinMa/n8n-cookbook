{
  "name": "03 · RSS News Digest by Email",
  "nodes": [
    {
      "parameters": {
        "content": "## 03 · RSS News Digest by Email\nEvery weekday at 08:00, read an RSS feed, keep only articles from the last 24 hours, take the top 10 and email them as one digest.\n\n**Needs:** an SMTP credential for **Send Digest Email** (Gmail, Outlook, Mailgun… all offer SMTP).\n\nTip: run once with **Manual Trigger** and look at the output of each node to see how *many items* become *one item* in **Combine Into One**.",
        "height": 320,
        "width": 460
      },
      "id": "03000000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "03000000-0000-4000-8000-000000000002",
      "name": "Weekdays 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 60]
    },
    {
      "parameters": {},
      "id": "03000000-0000-4000-8000-000000000003",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 240]
    },
    {
      "parameters": {
        "url": "https://hnrss.org/frontpage?points=100",
        "options": {}
      },
      "id": "03000000-0000-4000-8000-000000000004",
      "name": "Read RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [240, 150]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "03000000-0000-4000-8000-000000000101",
              "leftValue": "={{ $json.isoDate }}",
              "rightValue": "={{ $now.minus({ days: 1 }).toISO() }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "03000000-0000-4000-8000-000000000005",
      "name": "Only Last 24 Hours",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [460, 150]
    },
    {
      "parameters": {
        "maxItems": 10
      },
      "id": "03000000-0000-4000-8000-000000000006",
      "name": "Top 10",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [680, 150]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "articles",
        "options": {}
      },
      "id": "03000000-0000-4000-8000-000000000007",
      "name": "Combine Into One",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [900, 150]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "03000000-0000-4000-8000-000000000102",
              "name": "subject",
              "value": "=📰 Your news digest – {{ $now.toFormat('cccc, d LLL yyyy') }} ({{ $json.articles.length }} stories)",
              "type": "string"
            },
            {
              "id": "03000000-0000-4000-8000-000000000103",
              "name": "html",
              "value": "=<h2>Today's top stories</h2>\n<ol>\n{{ $json.articles.map(a => `<li><a href=\"${a.link}\">${a.title}</a><br><small>${a.comments ? `<a href=\"${a.comments}\">discussion</a>` : ''}</small></li>`).join('\\n') }}\n</ol>\n<p style=\"color:#888\">Sent by n8n · Example 03 of the n8n Cookbook</p>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "03000000-0000-4000-8000-000000000008",
      "name": "Build Email HTML",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 150]
    },
    {
      "parameters": {
        "fromEmail": "n8n@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "03000000-0000-4000-8000-000000000009",
      "name": "Send Digest Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1340, 150]
    }
  ],
  "connections": {
    "Weekdays 08:00": {
      "main": [[{ "node": "Read RSS Feed", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Read RSS Feed", "type": "main", "index": 0 }]]
    },
    "Read RSS Feed": {
      "main": [[{ "node": "Only Last 24 Hours", "type": "main", "index": 0 }]]
    },
    "Only Last 24 Hours": {
      "main": [[{ "node": "Top 10", "type": "main", "index": 0 }]]
    },
    "Top 10": {
      "main": [[{ "node": "Combine Into One", "type": "main", "index": 0 }]]
    },
    "Combine Into One": {
      "main": [[{ "node": "Build Email HTML", "type": "main", "index": 0 }]]
    },
    "Build Email HTML": {
      "main": [[{ "node": "Send Digest Email", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}

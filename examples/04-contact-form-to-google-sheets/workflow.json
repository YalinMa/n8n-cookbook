{
  "name": "04 · Contact Form to Google Sheets",
  "nodes": [
    {
      "parameters": {
        "content": "## 04 · Contact Form to Google Sheets\nn8n hosts the form for you — no website needed.\n\n1. **Contact Form** shows a web form (open its *Test URL* / *Production URL*)\n2. **Clean Up Data** trims text, lower-cases the email and adds a timestamp\n3. **Is Urgent?** routes urgent requests separately\n4. Every submission is appended as a row to Google Sheets\n\n**Needs:** a Google Sheets credential and a sheet with the header row:\n`Submitted At | Name | Email | Topic | Message | Urgent`",
        "height": 360,
        "width": 480
      },
      "id": "04000000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -360]
    },
    {
      "parameters": {
        "formTitle": "Contact us",
        "formDescription": "We usually reply within one business day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "placeholder": "Ada Lovelace",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "placeholder": "ada@example.com",
              "requiredField": true
            },
            {
              "fieldLabel": "Topic",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Sales" },
                  { "option": "Support" },
                  { "option": "Partnership" },
                  { "option": "Other" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Is this urgent?",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "No" },
                  { "option": "Yes" }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks! Your message has been received."
            }
          }
        }
      },
      "id": "04000000-0000-4000-8000-000000000002",
      "name": "Contact Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 100],
      "webhookId": "04000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "04000000-0000-4000-8000-000000000101", "name": "Submitted At", "value": "={{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}", "type": "string" },
            { "id": "04000000-0000-4000-8000-000000000102", "name": "Name", "value": "={{ $json.Name.trim() }}", "type": "string" },
            { "id": "04000000-0000-4000-8000-000000000103", "name": "Email", "value": "={{ $json.Email.trim().toLowerCase() }}", "type": "string" },
            { "id": "04000000-0000-4000-8000-000000000104", "name": "Topic", "value": "={{ $json.Topic }}", "type": "string" },
            { "id": "04000000-0000-4000-8000-000000000105", "name": "Message", "value": "={{ $json.Message.trim() }}", "type": "string" },
            { "id": "04000000-0000-4000-8000-000000000106", "name": "Urgent", "value": "={{ $json['Is this urgent?'] === 'Yes' }}", "type": "boolean" }
          ]
        },
        "options": {}
      },
      "id": "04000000-0000-4000-8000-000000000003",
      "name": "Clean Up Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 100]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "04000000-0000-4000-8000-000000000004",
      "name": "Append Row to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "04000000-0000-4000-8000-000000000107",
              "leftValue": "={{ $json.Urgent }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "04000000-0000-4000-8000-000000000005",
      "name": "Is Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 100]
    },
    {
      "parameters": {
        "content": "### Next step\nReplace this with a Slack, email or SMS node to ping someone about urgent requests.",
        "height": 140,
        "width": 260,
        "color": 7
      },
      "id": "04000000-0000-4000-8000-000000000006",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [840, -100]
    },
    {
      "parameters": {},
      "id": "04000000-0000-4000-8000-000000000007",
      "name": "Notify Team (placeholder)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 60]
    }
  ],
  "connections": {
    "Contact Form": {
      "main": [[{ "node": "Clean Up Data", "type": "main", "index": 0 }]]
    },
    "Clean Up Data": {
      "main": [[{ "node": "Append Row to Sheet", "type": "main", "index": 0 }]]
    },
    "Append Row to Sheet": {
      "main": [[{ "node": "Is Urgent?", "type": "main", "index": 0 }]]
    },
    "Is Urgent?": {
      "main": [
        [{ "node": "Notify Team (placeholder)", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}

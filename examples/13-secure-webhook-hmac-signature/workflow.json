{
  "name": "13 · Secure Webhook with HMAC Signature",
  "nodes": [
    {
      "parameters": {
        "content": "## 13 · Secure Webhook with HMAC Signature\nAnyone who knows a webhook URL can call it. Services like GitHub, Stripe and Shopify therefore **sign** each request: they send `HMAC-SHA256(secret, raw body)` in a header.\n\nThis workflow recomputes the signature over the **raw** request body and only processes the event when both match. Otherwise it returns **401**.\n\n⚠️ Change the secret in **Compute Signature** (and in your sender). Use a long random string.",
        "height": 340,
        "width": 500
      },
      "id": "13000000-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -380]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "signed-webhook",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "13000000-0000-4000-8000-000000000002",
      "name": "Signed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 100],
      "webhookId": "13000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "action": "hmac",
        "binaryData": true,
        "binaryPropertyName": "data",
        "type": "SHA256",
        "dataPropertyName": "expectedSignature",
        "secret": "change-me-to-a-long-random-secret",
        "encoding": "hex"
      },
      "id": "13000000-0000-4000-8000-000000000003",
      "name": "Compute Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [220, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "13000000-0000-4000-8000-000000000101",
              "leftValue": "={{ $json.headers['x-signature-256'] ?? '' }}",
              "rightValue": "=sha256={{ $json.expectedSignature }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "13000000-0000-4000-8000-000000000004",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "13000000-0000-4000-8000-000000000102", "name": "event", "value": "={{ $json.body.event }}", "type": "string" },
            { "id": "13000000-0000-4000-8000-000000000103", "name": "data", "value": "={{ $json.body.data }}", "type": "object" },
            { "id": "13000000-0000-4000-8000-000000000104", "name": "verifiedAt", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "13000000-0000-4000-8000-000000000005",
      "name": "Process Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, event: $json.event }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "13000000-0000-4000-8000-000000000006",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'invalid signature' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "13000000-0000-4000-8000-000000000007",
      "name": "Respond 401 Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 220]
    }
  ],
  "connections": {
    "Signed Webhook": {
      "main": [[{ "node": "Compute Signature", "type": "main", "index": 0 }]]
    },
    "Compute Signature": {
      "main": [[{ "node": "Signature Valid?", "type": "main", "index": 0 }]]
    },
    "Signature Valid?": {
      "main": [
        [{ "node": "Process Event", "type": "main", "index": 0 }],
        [{ "node": "Respond 401 Unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "Process Event": {
      "main": [[{ "node": "Respond 200 OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}

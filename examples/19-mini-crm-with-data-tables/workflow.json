      "id": "19000000-0000-4000-8000-000000000011",
      "name": "Get All Rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        420
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Optional ?stage=… filter, then one response item.\nconst stage = $('List Contacts').first().json.query.stage;\nconst contacts = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row.email) // ignore the empty item we get when the table is empty\n  .filter((row) => !stage || row.stage === stage)\n  .map(({ id, email, name, company, stage, notes, updatedAt }) => ({ id, email, name, company, stage, notes, updatedAt }));\n\nreturn [{ json: { count: contacts.length, stage: stage ?? 'all', contacts } }];"
      },

    },
    "One Item per Book": {
      "main": [[{ "node": "Rated 4★+ and In Stock", "type": "main", "index": 0 }]]
    },
    "Rated 4★+ and In Stock": {
      "main": [[{ "node": "Cheapest First", "type": "main", "index": 0 }]]
    },
    "Cheapest First": {
      "main": [[{ "node": "Export CSV", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
